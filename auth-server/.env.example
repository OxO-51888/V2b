AUTH_HOST=127.0.0.1
AUTH_PORT=8787
AUTH_ISSUER=XiaoV2B Authorization
AUTH_ADMIN_TOKEN=please-change-this-long-random-token
AUTH_ADMIN_PATH=/shouquan
AUTH_ALLOWED_CLIENTS=windows-auth
AUTH_MIN_VERSION=0.1.0
AUTH_SESSION_TTL_SECONDS=900
AUTH_AUTO_APPROVE=true
AUTH_DEVICE_APPROVAL_REQUIRED=false
AUTH_PUBLIC_BASE_URL=https://auth.example.com
AUTH_BIND_CLIENT_NAME=true
AUTH_PANELS_CONFIG=/app/config/panels.json
AUTH_LICENSE_KEY_SECRET=please-change-this-license-key-secret
AUTH_PANEL_URL=https://panel.example.com
AUTH_PANEL_CLIENT_ID=windows
AUTH_PANEL_CLIENT_VERSION=0.1.0
AUTH_PANEL_SIGN_SECRET=please-change-this-panel-sign-secret
AUTH_PANEL_REQUEST_TIMEOUT_MS=30000
AUTH_DB_DRIVER=mysql
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_NAME=xiaov2b_auth
AUTH_DB_USER=xiaov2b_auth
AUTH_DB_PASSWORD=please-change-this-db-password
