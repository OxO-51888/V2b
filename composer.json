{
    "name": "v2board/v2board",
    "type": "project",
    "description": "v2board is a proxy protocol manage.",
    "keywords": [
        "v2board",
        "v2ray",
        "shadowsocks",
        "trojan",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "~8.5.12",
        "ext-sodium": "*",
        "firebase/php-jwt": "^7.2.1",
        "google/recaptcha": "^1.2",
        "guzzlehttp/guzzle": "^7.4.3",
        "laravel/framework": "^13.38.0",
        "laravel/horizon": "^5.9.6",
        "laravel/tinker": "^3.0",
        "php-curl-class/php-curl-class": "^13.0",
        "rybakit/msgpack": "^0.9.1",
        "stripe/stripe-php": "^v14.9.0",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {"php": "8.5.12"}
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Library\\": "library/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "exclude-from-classmap": ["tests/security/"],
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://packagist.org"
        }
    }
}
